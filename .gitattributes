# Normalize line endings to LF on commit for text files
* text=auto

# Explicitly treat source & config files as text
*.ts     text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.env    text eol=lf
*.sh     text eol=lf
*.cjs    text eol=lf
*.mjs    text eol=lf
.gitignore  text eol=lf

# Binary files - never try to normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.gif  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.tgz  binary
*.lock binary

# Windows binary executables
*.exe binary
*.dll binary