    {
      "name": "/tokens",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Lưu Token vào Collection Variables\", function () {\r",
              "    // 1. Phân giải dữ liệu JSON từ phản hồi của API\r",
              "    var jsonData = pm.response.json();\r",
              "    var myToken = jsonData.token; \r",
              "    \r",
              "    // 2. Lưu vào Collection Variables\r",
              "    pm.collectionVariables.set(\"TOKEN\", myToken);\r",
              "    \r",
              "    console.log(\"Đã lưu token mới: \" + myToken);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
